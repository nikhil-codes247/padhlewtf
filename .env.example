# ---------------------------------------------------------------------------
# PADHLE.WTF — Cloudflare Pages environment variables
#
# Add these in Cloudflare dashboard:
#   Your site → Settings → Environment variables → Production
# Never commit real secrets. This file is a template only.
# ---------------------------------------------------------------------------

# Razorpay — one-time purchase ₹199 until 10 March 2027.
# KEY_ID is public (reaches the browser via config.js); KEY_SECRET is server-side only.
RAZORPAY_KEY_ID=rzp_test_<your-test-key-id>
RAZORPAY_KEY_SECRET=<your-test-key-secret>

# Supabase (the app's backend)
PADHLE_SUPABASE_URL=https://<your-project-ref>.supabase.co
PADHLE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Site
PADHLE_SITE_URL=https://<your-site>.pages.dev
PADHLE_ENV=production
